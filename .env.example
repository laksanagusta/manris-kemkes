# ===========================================
# Manris v2 Production Environment Variables
# ===========================================
# Copy this to .env.production and fill in real values
# NEVER commit .env.production to git

# Database (PostgreSQL)
POSTGRES_USER=manris
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=manris
DATABASE_URL=postgres://manris:CHANGE_ME_STRONG_PASSWORD@postgres:5432/manris?sslmode=disable

# Backend
PORT=8080
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
JWT_EXPIRY_HOURS=24
CORS_ORIGINS=https://manris.marvcore.com
OPENAI_API_KEY=sk-your-openai-api-key-here

# Frontend (build-time only - set as Docker build arg)
NEXT_PUBLIC_API_URL=https://api-manris.marvcore.com/api/v1
