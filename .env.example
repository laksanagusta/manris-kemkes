# ===========================================
# Manris v2 Production Environment Variables
# ===========================================
# Copy this to .env.production and fill in real values
# NEVER commit .env.production to git

# Database (PostgreSQL)
POSTGRES_USER=manris
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=manris
DATABASE_URL=postgres://manris:CHANGE_ME_STRONG_PASSWORD@postgres:5432/manris?sslmode=disable

# Backend
PORT=8080
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
JWT_EXPIRY_HOURS=24
CORS_ORIGINS=https://manrisk.dikalaksana.com
OPENAI_API_KEY=sk-your-openai-api-key-here
RISK_APPROVAL_WORKFLOW_ENABLED=false

# Frontend (build-time only - set as Docker build arg)
NEXT_PUBLIC_API_URL=https://api-manrisk.dikalaksana.com/api/v1

# Backend and frontend runtime: trusted public origin for reset links and auth requests.
AUTH_APP_ORIGIN=https://manrisk.dikalaksana.com

# Required for self-service registration and email password recovery. Use a verified SMTP sender.
AUTH_SMTP_ADDR=
AUTH_SMTP_MODE=starttls
AUTH_SMTP_FROM=
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
